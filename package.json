{
  "name": "ticktick-axi",
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "description": "AXI-compliant TickTick CLI for agents — token-efficient TOON output, contextual suggestions, gated writes",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hafeezhmha/ticktick-axi.git"
  },
  "keywords": [
    "ticktick",
    "tasks",
    "todo",
    "cli",
    "agent",
    "axi",
    "toon",
    "llm"
  ],
  "bin": {
    "ticktick-axi": "./dist/bin/ticktick-axi.js"
  },
  "files": [
    "dist",
    "skills/ticktick-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:skill": "tsx scripts/build-skill.ts",
    "dev": "tsx bin/ticktick-axi.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "license": "MIT",
  "author": "hafeezhmha",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.1",
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
